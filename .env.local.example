# Copy this file to .env.local and fill in real values.
# Both are NEXT_PUBLIC_ because they're read in the browser (client SDK init,
# and the Web Experimentation snippet URL) — do not put secrets in either.

# Feature Experimentation (React SDK) — SDK key from Settings > Environments
# in your FX project.
NEXT_PUBLIC_OPTIMIZELY_SDK_KEY=

# Web Experimentation — the numeric project ID from your snippet's script
# tag: https://cdn.optimizely.com/js/<PROJECT_ID>.js
NEXT_PUBLIC_OPTIMIZELY_WEB_PROJECT_ID=
