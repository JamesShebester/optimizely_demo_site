# Copy this file to .env.production.local and fill in real values.
# Next.js loads this automatically for `npm run build` (always a
# production build) — it takes priority over .env.local for that build,
# so this is the file that ends up baked into the static export you
# deploy to Cloudflare.
#
# Both are NEXT_PUBLIC_ because they're read in the browser (client SDK
# init, and the Web Experimentation snippet URL) — do not put secrets in
# either.

# Feature Experimentation (React SDK) — SDK key from Settings > Environments
# in your FX project.
NEXT_PUBLIC_OPTIMIZELY_SDK_KEY=

# Web Experimentation — the numeric project ID from your snippet's script
# tag: https://cdn.optimizely.com/js/<PROJECT_ID>.js
NEXT_PUBLIC_OPTIMIZELY_WEB_PROJECT_ID=
